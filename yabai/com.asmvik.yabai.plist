<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Label is deliberately NOT com.asmvik.yabai: that exact label got
         into a broken/poisoned state in launchd's database this machine
         (repeated create/delete cycles while debugging) — every load
         attempt fails with "Input/output error" regardless of file
         content, confirmed by testing a minimal plist under both labels.
         `yabai --restart-service` hardcodes this FILENAME, not the
         internal label, so the working label lives here instead. -->
    <key>Label</key>
    <string>com.schingon.yabai</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/yabai</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/yabai_schingon.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/yabai_schingon.err.log</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
