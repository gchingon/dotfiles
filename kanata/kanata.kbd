;;────────────────────────────────────────────
;; kanata.kbd — Cross-platform Kanata config
;; Dvorak keyboard layout on physical QWERTY positions
;; Runs as LaunchDaemon (macOS) or systemd unit (Linux)
;;
;; LAYER MAP:
;;   main     — daily typing, home row mods
;;   apps     — app switching         (hold caps)
;;   toggles  — system toggles/power  (hold tab)
;;   goto     — nvim/Obsidian jumps   (hold lmet / left ⌘)
;;   raycast  — raycast + system      (caps+u chord, one-shot 3s)
;;   yabai    — window placement      (hold RGUI/rmet)
;;   emoji    — quick emoji           (double-tap Esc)
;;────────────────────────────────────────────

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold   yes
  danger-enable-cmd     yes
  chords-v2-min-idle    80
)

;;────────────────────────────────────────────
;; Variables
;;────────────────────────────────────────────
(defvar
  tap-higher 400
  tt 300
  ht 300
  kord-t 500
  subl-t 500

  ;; Absolute paths — kanata runs as root LaunchDaemon so $HOME = /var/root.
  ;; These defvar values are substituted at parse time, before cmd reaches the shell.
  UH /Users/schingon
  CF (concat $UH /.config)
  RX (concat $CF /rx)
  LB (concat $UH /.local/bin)
)

;;────────────────────────────────────────────
;; Includes — alias files with platform blocks inside
;;────────────────────────────────────────────
(include aliases-shared.kbd)
(include aliases-apps.kbd)
(include aliases-goto.kbd)
(include aliases-toggles.kbd)
(include aliases-kitty.kbd)
(include aliases-system.kbd)
(include aliases-raycast.kbd)
;; (include aliases-emoji.kbd)

;;────────────────────────────────────────────
;; Sublayer entry — chords activate layers
;; caps (hold, no chord)   → apps    — see mehsc in aliases-shared.kbd
;; tab  (hold, no chord)   → toggles — see tabSG in aliases-shared.kbd
;; lmet (hold, no chord)   → yabai   — see suXMS in aliases-shared.kbd
;; rmet (hold, no chord)   → goto    — see hyper in aliases-shared.kbd
;; caps+u → raycast (one-shot 3s)
;; lctl+down+[ → restart yabai service (uncommon on purpose; physical keys,
;;               so this is lctl+down+/ in Dvorak output). Was lalt, but
;;               alt is a dead-key modifier on macOS (alt+/ → ¿) and passed
;;               through instead of being caught as a chord.
;; Chord timeout $kord-t = 500ms
;;────────────────────────────────────────────
(defchordsv2
  (caps r)      (one-shot 3000 (layer-while-held raycast)) $kord-t all-released ()
  (lctl down [) @yb-rst                                    $kord-t all-released ()
)

;;────────────────────────────────────────────
;; defsrc — 77-key MacBook physical layout
;; Order MUST match all deflayer declarations exactly.
;; These are hardware key positions, not Dvorak chars.
;;────────────────────────────────────────────
(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    up   rsft
  fn   lctl lalt lmet           spc            rmet ralt left down rght
)

;;────────────────────────────────────────────
;; MAIN layer — daily typing, home row mods
;; Physical positions → Dvorak output via process-unmapped-keys
;;
;; caps (hold) → apps layer; tap = esc
;; tab  (hold) → toggles layer; tap = tab
;; lmet (hold) → yabai layer; tap = Force Quit dialog
;; rmet (hold) → goto layer; tap = f18
;; caps+u chord → raycast layer (one-shot 3s)
;;────────────────────────────────────────────
(deflayer main
  _      brdn    brup    f3      f4      f5      f6      prev    pp      next    mute    vold    volu          ;; Fn row
  @grasc 1       2       3       4       5       6       7       8       9       0       _       _       _     ;; NUM
  @tabSG _       _       @mhome  _       _       _       _       _       _       _       _       _       _     ;; QWERTY
  @mehsc @Hlctl  _       @Hlalt  @Hlmet  _       _       @Hrmet  @Hralt  _       @Hrctl  _       _        ;; HOME
  lsft   _       _       _       _       _       _       _       _       _       _       _       @shdel        ;; BOTTOM
  fn     @caltb  @shalt  @suXMS            spc           @hyper  @trams  _       _       _                     ;; MOD
)

;;────────────────────────────────────────────
;; APPS layer — app switching
;; Activated by: hold caps (tap is still esc), see mehsc in aliases-shared.kbd
;;
;; QWERTY y/u/i/o/p = Spotify/Passwords/Calendar/Preview/DaVinci Resolve
;; HOME   h/j/k/l/;/' = Comet/Claude/Obsidian/Notes/Messages/System Settings
;; HOME   ret         = kitty (terminal)
;; BOTTOM n/m/,/./  = Finder/ Grok Bot / WhatsApp / clipboard history /Affinity Designer
;;────────────────────────────────────────────
(deflayer apps
  _      _       _       _       _       _       _       _       _       _       _       _       _            ;; Fn
  grv    _       _       _       _       _       _       _       _       _       _       _       _      _     ;; NUM
  _      _       _       _       _       _       @a-spot @a-pass @a-cale @a-prev @a-davr _       _      _     ;; QWERTY
  _      _       _       _       _       _       @a-comt @a-clau @a-obsi @a-note @a-msgs @a-sset @a-term       ;; HOME
  _      _       _       _       _       _       @a-find @a-grok @a-what @rclip  @a-afnt _       _             ;; BOTTOM
  _      _       _       _              _               _       _       _       _       _                     ;; MOD
)

;;────────────────────────────────────────────
;; RAYCAST layer — Raycast utilities + kitty jumps + system utilities
;; Activated by: caps+u chord (one-shot 3s)
;;
;; QWERTY e–o → kitty sessions:
;;   e=dotfiles  r=nvim  t=docker  y=podcast  u=home  i=ssh2  o=ssh4
;; Raycast: a=AI d=Files f=Emoji g=Spotify h=YouTube
;; System: p=Screenshot z/x/c=Audio/Wifi/Bluetooth j=AirDrop k=Mic n=Meeting m=Dots ,=Theme .=SketchyBar
;;────────────────────────────────────────────
(deflayer raycast
  _       XX      XX      XX      XX      XX      XX      XX      XX      XX      XX      XX      XX           ;; Fn
  grv     1       2       3       4       5       6       7       8       9       0       _       _      _     ;; NUM
  _       XX      XX      @k-dots @k-nvim @k-dckr @k-podc @k-home @k-ssh2 @k-ssh4 @sys-cap _       _      _     ;; QWERTY
  _       @rayai  XX      @rfile  @remoj  @sptfd  @tbefd  @sys-shr @sys-mic XX      XX      _       _             ;; HOME
  _       @sys-aud @sys-wfi @sys-blu XX   XX      @sys-cal @sys-dot @sys-col @sys-sbar XX    _       _             ;; BOTTOM
  _       _       _       _              _                _       _       _       _       _                     ;; MOD
)

;;────────────────────────────────────────────
;; YABAI layer — window placement
;; Activated by: hold LGUI/lmet (tap is still Force Quit dialog)
;;
;; j/p = cycle left/right widths
;; t/y = move window to prev/next display (and follow it)
;; i/o = top-left/top-right
;; ,/. = bottom-left/bottom-right
;; 1/2/3 = thirds
;; q/w/e = ultrawide top sixths, a/s/d = ultrawide bottom sixths
;; m = fullscreen
;; r = top half/top quarter/second quarter
;; f = bottom half/third quarter/bottom quarter
;; v = top/middle/bottom third
;;────────────────────────────────────────────
(deflayer yabai
  _      _       _       _       _       _       _        _        _        _        _        _      _            ;; Fn
  grv    @y-3l   @y-3c   @y-3r   _       5       6        7        8        9        0        _      _      _     ;; NUM
  _      @y-6tl  @y-6tc  @y-6tr  @y-ctop @y-dprev @y-dnext _        @y-tl    @y-tr    @y-right _      _      _     ;; QWERTY
  _      @y-6bl  @y-6bc  @y-6br  @y-cbot _       _        @y-left  _        _        _        _      _             ;; HOME
  _      _       _       _       @y-c3rd _       _        @y-full  @y-bl    @y-br    _        _      _             ;; BOTTOM
  _      _       _       _              _                _        _        _        _        _                    ;; MOD
)

;;────────────────────────────────────────────
;; TOGGLES layer — system toggles + power
;; Activated by: hold tab (tap is still tab), see tabSG in aliases-shared.kbd
;;
;; QWERTY y/u/i/o/p = Screensaver/Printers&Scanners/Zoom toggle/Calculator/AirDrop
;; HOME   h/j/k/l/;/' = Wifi/Bluetooth/Lock/DND/Mute mic/Caffeinate toggle
;; BOTTOM n/m/,/./  = Sleep/Restart/Shut Down/Log Out/System Information
;;────────────────────────────────────────────
(deflayer toggles
  _      _       _       _       _       _       _       _       _       _       _       _       _            ;; Fn
  grv    _       _       _       _       _       _       _       _       _       _       _       _      _     ;; NUM
  _      _       _       _       _       _       @tg-scrn @tg-prnt @tg-zoom @tg-calc @sys-shr _   _      _     ;; QWERTY
  _      _       _       _       _       _       @sys-wfi @sys-blu @tg-lock @tg-dnd  @sys-mic @tg-caff _       ;; HOME
  _      _       _       _       _       _       @tg-slep @tg-rest @tg-shut @tg-lout @tg-info _       _             ;; BOTTOM
  _      _       _       _              _               _       _       _       _       _                     ;; MOD
)

;;────────────────────────────────────────────
;; GOTO layer — nvim/Obsidian directory jumps
;; Activated by: hold RGUI/rmet (right ⌘), tap is unchanged (f18)
;;
;; HOME h/j/k/l = nvim in .config/repos/Documents/notes (kitty, reuses tab)
;; QWERTY y/u/i/o = same 4 directories, opened in Obsidian instead
;; repos/Documents/notes resolve per-machine via zshenv ($RP/$DX/$NT) —
;; see aliases-goto.kbd. Room to grow: ;/'/p and the whole BOTTOM row.
;;────────────────────────────────────────────
(deflayer goto
  _      _       _       _       _       _       _       _       _       _       _       _       _            ;; Fn
  grv    _       _       _       _       _       _       _       _       _       _       _       _      _     ;; NUM
  _      _       _       _       _       _       @obs-dots @obs-repos @obs-docs @obs-notes _      _      _      _     ;; QWERTY
  _      _       _       _       _       _       @gt-dots  @gt-repos  @gt-docs  @gt-notes  _      _      _            ;; HOME
  _      _       _       _       _       _       _       _       _       _       _       _       _             ;; BOTTOM
  _      _       _       _              _               _       _       _       _       _                     ;; MOD
)

;;────────────────────────────────────────────
;; EMOJI layer — quick emoji output
;; Activated by: double-tap Esc (one-shot)
;; Single tap esc = esc, double-tap = emoji one-shot
;;
;; Physical key → emoji (see aliases-emoji.kbd for codepoints):
;;   1 = 💯  2 = 💀
;;   q = 🤯  w = 🤞  e = 🙄  r = 🤘  t = 🤐  y = 🖕  i = 😒  o = 👌
;;   a = 🙌🏼  s = 😈  d = 😏  f = 🙏  h = ❤️  j = 🤣  k = 😘  l = 😍
;;   z = 🫖  x = 🤷🏼‍♂️  c = 🎉  v = 🤨  n = 👎  m = 💰 , = 🤢 . = 😳
;;   rarrow = → larrow = ← uarrow = ↑ darrow = ↓
;;────────────────────────────────────────────
;; (deflayer emoji
;;   _      XX      XX      XX      XX      XX      XX      XX      XX      XX      XX      XX      XX           ;; Fn
;;   _      @em-100 @em-skl 3       4       5       6       7       8       9       0       _       _       _    ;; NUM
;;   _      @em-blo @em-wsh @em-eye @em-rck @em-zip @em-flp XX      @em-unm @em-ok  XX      XX      XX      XX    ;; QWERTY
;;   _      @em-hnd @em-dev @em-smr @em-pry XX      @em-hrt @em-cry @em-kis @em-lov XX      XX      XX            ;; HOME
;;   _      @em-tea @em-shr @em-cel @em-sus XX      @em-no  @em-mny @em-sck @em-flu @em-uar XX      XX            ;; BOTTOM
;;   _      _       _       _              _               _       _       @em-lar @em-dar @em-rar              ;; MOD
;; )

;;────────────────────────────────────────────
;; TEMPLATE — copy this to add new layers
;; (deflayer template
;;   _    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX               ;; Fn
;;   _    _     _     _     _     _     _     _     _     _     _     _     _     _          ;; NUM
;;   _    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX         ;; QWERTY
;;   XX   XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX               ;; HOME
;;   XX   XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX    XX               ;; BOTTOM
