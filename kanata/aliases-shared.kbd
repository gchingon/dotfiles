;; mtrsh must be defined before the main defalias block below, since `trams`
;; there references it (kanata requires forward-declared aliases to come
;; first — see the `scam*` note further down).
(platform (macos)
  (defalias
    ;; Direct Finder empty-trash (native confirm dialog) — was a Raycast
    ;; deeplink, but that just opened Raycast without actually running the
    ;; extension reliably.
    mtrsh (cmd zsh -lc "/Users/schingon/.config/rx/system-toggle.sh trash")
  )
)
(platform (linux)
  (defalias
    mtrsh (cmd bash -c "trash-empty 2>/dev/null || rm -rf ~/.local/share/Trash/files/*")
  )
)

(defalias
  ;; -----------------------------
  ;; Base modifier combos
  ;; -----------------------------
  hypur (multi lalt lctl lmet lsft)
  meh   (multi lalt lctl lsft)
  AC    (multi lalt lctl)
  AS    (multi lalt lsft)
  AMS   (multi lalt lmet lsft)
  CS    (multi lctl lsft)
  CMS   (multi lctl lmet lsft)
  MS    (multi lmet lsft)
  MSa   (multi @MS a)
  tabal (multi lalt tab)
  force (multi lalt lmet esc)

  ;; -----------------------------
  ;; Scam aliases (must be before double-action keys that reference them)
  ;; -----------------------------
  scam6 (multi @hypur 6)
  scam0 (multi @hypur 3)
  scamt (multi @hypur 4)
  scamh (multi @hypur h)
  scamw (multi @hypur w)
  scams (multi @hypur s)

  ;; -----------------------------
  ;; Home row mods
  ;; -----------------------------
  Hlctl (tap-hold $tt $ht a lctl)
  Hlalt (tap-hold $tt $ht d lalt)
  Hlmet (tap-hold $tt $ht f lmet)
  Hrmet (tap-hold $tt $ht j rmet)
  Hralt (tap-hold $tt $ht k ralt)
  Hrctl (tap-hold $tt $ht ; lctl)

  ;; -----------------------------
  ;; Double-action keys
  ;; -----------------------------
  caltb (tap-hold $tt $ht @tabal @AC)
  grasc (tap-hold $tt $ht grv @CS)
  ;; Hold = yabai layer (window placement, aliases-system.kbd's y-*). Tap is
  ;; unchanged (f18, currently unused elsewhere). hypur is kept as a plain
  ;; alias — still used as a building block by scam6/scam0/etc below.
  hyper (tap-hold $tt $ht f18 (layer-while-held yabai))
  ;; Hold = apps layer (app launching, aliases-apps.kbd). Tap is unchanged
  ;; (esc). meh is kept as a plain alias for anything else.
  mehsc (tap-hold $tt $ht esc (layer-while-held apps))
  mhome (tap-hold $tt $ht e @scam6)
  shalt (tap-hold $tt $ht @scam0 @AS)
  ;; Hold = goto layer (nvim/Obsidian directory jumps, aliases-goto.kbd).
  ;; Tap is unchanged (Force Quit dialog). CMS is kept as a plain alias in
  ;; case anything else still wants literal ctrl+cmd+shift.
  suXMS (tap-hold $tt $ht @force (layer-while-held goto))
  ;; Hold = toggles layer (system toggles/power, aliases-toggles.kbd). Tap
  ;; is unchanged (tab). MS is kept as a plain alias for anything else.
  tabSG (tap-hold $tt $ht tab (layer-while-held toggles))
  zmute (tap-hold $tt $ht ' @MSa)

  ;; -----------------------------
  ;; Right Shift: tap del, hold shift
  ;; -----------------------------
  shdel (tap-hold $tt $ht del rsft)

  ;; -----------------------------
  ;; Right Alt: tap empty-trash, hold hyper-ish chord
  ;; mtrsh/trams platform blocks are below, after this defalias block closes.
  ;; -----------------------------
  trams (tap-hold $tt $ht @mtrsh (multi lalt lmet lsft))

  ;; -----------------------------
  ;; Esc: tap-dance
  ;;   tap        → esc
  ;;   double-tap → one-shot emoji layer
  ;; -----------------------------
  ;;escem (tap-dance 300 (esc (one-shot 2000 (layer-while-held emoji))))

  ;; -----------------------------
  ;; Layer entry aliases (sublayer holds)
  ;; Hold physical key → activate layer while held
  ;; -----------------------------
  ;; apps layer: triggered by tapping into it from main via dedicated key
  ;; raycast layer: hold physical `c` area — defined on main layer
  ;; system layer: hold physical `g` — defined on main layer
)
